ser_get_html\",\"browser_click\",\"browser_fill\",\"browser_screenshot\",\"browser_back\",\"browser_forward\",\"browser_wait_for\",\"browser_press_key\",\"view_video\",\"listen_audio\",\"load_skill\"]},{\"id\":\"claude-opus-4-7\",\"label\":\"Claude Opus 4.7\",\"ai_name\":\"claude\",\"description\":\"<p>Claude Opus 4.7 handles complex multi-step tasks involving code, tools, images and on-screen content. It follows detailed instructions closely, keeps working when a step fails and helps carry tasks through to completion. It is well suited to software development, complex document analysis and work with interfaces.</p><p><strong>Key capabilities:</strong></p><ul><li>multi-step tasks</li><li>tool use</li><li>visual analysis</li></ul>\",\"enabled\":true,\"is_free\":false,\"icon\":null,\"performance_level\":3,\"free_from_sub\":null,\"available_subscriptions\":[],\"min_subscription\":null,\"context_window\":256000,\"default_max_tokens\":32000,\"max_images_count\":0,\"capabilities\":{\"thinking\":true,\"planning\":true,\"deep_research\":true,\"web_explorer\":true,\"files\":true,\"images\":true,\"system_message\":true,\"streaming\":true},\"supported_tools\":[\"search_web\",\"web_extract\",\"web_crawl\",\"web_map\",\"show_place\",\"run_code\",\"run_shell\",\"file_write\",\"file_read\",\"file_edit\",\"list_directory\",\"show_preview\",\"present_files\",\"file_load\",\"plan_create\",\"plan_status\",\"task_update\",\"generate_chart\",\"browser_navigate\",\"browser_get_text\",\"browser_get_html\",\"browser_click\",\"browser_fill\",\"browser_screenshot\",\"browser_back\",\"browser_forward\",\"browser_wait_for\",\"browser_press_key\",\"view_video\",\"listen_audio\",\"load_skill\"]},{\"id\":\"claude-opus-4-8\",\"label\":\"Claude Opus 4.8\",\"ai_name\":\"claude\",\"description\":\"<p>Claude Opus 4.8 brings a careful, critical approach to demanding professional work. It examines extensive documents, visual material and data, spots inconsistencies, flags uncertainty and stays focused a