            "mimeType": "application/json",
            "text": "{\"header\":[{\"uuid\":\"ce850aed-72e9-48e3-b8cb-f3ecddda2a04\",\"body\":\"<p><strong>Seedance 2.5</strong> promo contest with a <strong>$20,000</strong> prize pool | <a target=\\\"_blank\\\" rel=\\\"noopener noreferrer nofollow\\\" href=\\\"https://syntx.ai/contest/seedance\\\">Enter now</a></p>\",\"open_in_new_tab\":true,\"order\":1,\"start_date\":\"2026-08-24T12:32:00Z\",\"end_date\":null,\"updated_at\":\"2026-08-28T07:00:26Z\"}],\"landing\":[{\"uuid\":\"b2feda2a-7e75-4c97-8f7a-ecaf680571c5\",\"primary_title\":\"Hailuo MiniMax 3.0\",\"secondary_title\":\"2K VIDEO WITH AUDIO\",\"subtitle\":null,\"feature\":\"2K • Up to 15 sec. • Omni Reference • Keyframes\",\"description\":\"Hailuo MiniMax 3.0 generates videos at up to 2K resolution and creates audio alongside the video. Use images, video, and audio as references, set the first and last frames, and create clips up to 15 seconds long.\",\"type\":\"info\",\"model_name\":\"Hailuo MiniMax 3.0\",\"button\":{\"active\":true,\"link\":\"https://syntx.ai/video/hailuo-minimax\",\"text\":\"Open MiniMax 3.0 \",\"new_tab\":true},\"date\":null,\"media_url\":[\"https://r2.syntx.ai/ERP/landing_banners/tURw10wrD3QrcpXA41abgXA47u4RHgs22tsJiAzX.mp4\"],\"order\":1,\"variant\":2,\"start_date\":\"2026-08-26T13:59:00Z\",\"end_date\":null,\"updated_at\":\"2026-08-26T14:10:45Z\"},{\"uuid\":\"0e7787a8-6166-4fe0-b14c-d2493075252c\",\"primary_title\":\"Create the Best Promo\",\"secondary_title\":\"for Seedance 2.5\",\"subtitle\":\"Show what the model can do and compete for a share of the $20,000 prize pool\",\"feature\":\"Any style • Any genre • Your idea\",\"description\":\"reate a Seedance 2.5 promo built around a strong idea, story, or visual concept. Show what makes the model stand out and why people will want to try it.\",\"type\":\"contest\",\"model_name\":\"Seedance 2.5 promo contest \",\"button\":{\"active\":true,\"link\":\"https://syntx.ai/contest/seedance\",\"text\":\"View contest\",\"new_tab\":true},\"date\":null,\"media_url\":[\"https://r2.syntx.ai/ERP/landing_banners/N3oqci9f0deh6WxuGsYDFTQ9SFULsyY1XH3v04Wa.mp4\"],\"order\":1,\"variant\":1,\"start_date\":\"2026-08-24T12:05:00Z\",\"end_date\":null,\"updated_at\":\"2026-08-24T12:28:35Z\"},{\"uuid\":\"85ee6669-0c87-4838-a499-e4373f33025f\",\"primary_title\":\"Seedance 2.5 1080p\",\"secondary_title\":\"Sharper, clearer video\",\"subtitle\":null,\"feature\":\"1080p · Up to 30 sec. · Up to 50 refs · Keyframes\",\"description\":\"Seedance 2.5 now creates seamless videos directly in 1080p, with no extra upscaling. Images are sharper, with clearer detail in complex scenes. All core features remain: videos up to 30 seconds, up to 50 references, Omni Reference, and Keyframes.\",\"type\":\"info\",\"model_name\":\"Seedance 2.5 1080p\",\"button\":{\"active\":true,\"link\":\"https://syntx.ai/video/seedance\",\"text\":\"Open Seedance 2.5\",\"new_tab\":true},\"date\":null,\"media_url\":[\"https://r2.syntx.ai/ERP/landing_banners/DWVpt3LSUNToDCrUjIVaTA54zPaWlmcilST8tycv.mp4\"],\"order\":1,\"variant\":2,\"start_date\":\"2026-08-18T19:40:00Z\",\"end_date\":null,\"updated_at\":\"2026-08-18T20:09:16Z\"},{\"uuid\":\"40126e82-d782-441e-aacd-468ac1d9a51d\",\"primary_title\":\"Models just got\",\"secondary_title\":\"100× smarter\",\"subtitle\":\"Our biggest LLM upgrade yet\",\"feature\":\"Web access • Code • Files • Cross-model context\",\"description\":\"Give a model a task and it will plan the work, search the web, review sources, run code, analyze files, and carry every step through to result. Switch models in the same chat without losing context.\",\"type\":\"info\",\"model_name\":\"LLM Studio\",\"button\":{\"active\":true,\"link\":\"https://syntx.ai/text/chatgpt\",\"text\":\"Open LLM Studio\",\"new_tab\":true},\"date\":null,\"media_url\":[\"https://r2.syntx.ai/ERP/landing_banners/4YgmMEEYJBhrtEykBlwaHKTqfFlaaBduQolNfkuu.jpg\"],\"order\":3,\"variant\":3,\"start_date\":\"2026-07-31T14:44:00Z\",\"end_date\":null,\"updated_at\":\"2026-08-11T14:42:51Z\"}]}"
