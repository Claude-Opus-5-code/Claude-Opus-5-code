            "text": "{\"profile.profile\":\"Profile\",\"profile.synchronization\":\"Synchronization\",\"profile.renew\":\"Buy subscription\",\"profile.paymentHistory\":\"Payment history\",\"profile.tokenDescription\":\"the internal currency of the service\",\"profile.addMore\":\"Add more\",\"profile.tokenHistory\":\"Token history\",\"profile.referrals\":\"Referrals\",\"profile.referralList\":\"Go to the list of referrals\",\"profile.referralInfo\":\"Send your unique link to friends/colleagues to earn money with SYNTX\",\"profile.balance\":\"Partner tokens\",\"profile.sales\":\"Total sales\",\"profile.total\":\"Sales amount\",\"profile.documentation\":\"Documentation\",\"profile.feed\":\"Feed\",\"profile.filter\":\"Filter\",\"profile.noTexts\":\"You don't have any text chats yet\",\"profile.noImages\":\"You don't have any images yet\",\"profile.noVideos\":\"You don't have any videos yet\",\"profile.noAudio\":\"You don't have any audio yet\",\"profile.whatInPlan\":\"Included in the plan\",\"profile.planUntil\":\"Subscription until\",\"profile.changePlan\":\"Change plan\",\"profile.cancelAutoRenewal\":\"Cancel auto-renewal\",\"profile.renewPlan\":\"Renew\",\"profile.renewNotification\":\"Your subscription has been successfully renewed\",\"profile.renewDetails\":\"Renewal details:<br><ul><li>Plan: {plan}</li><li>New period: from {startDate} to {endDate}</li></ul>\",\"profile.userSettings.title\":\"User settings\",\"profile.userSettings.name\":\"Name\",\"profile.userSettings.username\":\"Username\",\"profile.userSettings.nameError\":\"Name is required\",\"profile.userSettings.usernameError\":\"Username is required\",\"profile.userSettings.nameMin\":\"Name must be between 2 and 50 characters\",\"profile.userSettings.usernameMin\":\"Username must be between 3 and 20 characters\",\"profile.referral.list\":\"My referrers\",\"profile.referral.hasPayments\":\"Payments\",\"profile.referral.createdAt\":\"Registration date\",\"profile.referral.mostActive\":\"The most active\",\"p