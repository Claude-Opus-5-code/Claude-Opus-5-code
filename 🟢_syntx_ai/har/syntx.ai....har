            "text": "{\"payment.giftTo\":\"Gift to\",\"payment.purchaseTariff\":\"Purchase subscription\",\"payment.backToPlans\":\"Back to plans\",\"payment.recipient\":\"Recipient\",\"payment.paymentMethod\":\"Payment method\",\"payment.userTg\":\"Telegram username\",\"payment.selectPaymentMethod\":\"Select payment method\",\"payment.subscriptionPeriod\":\"Subscription period\",\"payment.selectSubscriptionPeriod\":\"Select subscription period\",\"payment.promocode\":\"Promocode\",\"payment.promocodePlaceholder\":\"Enter promocode\",\"payment.applyPromocode\":\"Apply promocode\",\"payment.promocodeApplied\":\"Promocode applied\",\"payment.promocodeNotApplied\":\"Promocode is not valid\",\"payment.cancelPromocode\":\"Cancel promocode\",\"payment.promocodeWrongPlan\":\"Promocode is valid only for the subscription \",\"payment.promocodeWrongPeriod\":\"Promocode is valid only for the subscription on the period from \",\"payment.promoFreePeriod\":\"With this promo code you get a free extension of your subscription for\",\"payment.month\":\"{n} month | {n} months\",\"payment.year\":\"year\",\"payment.discount\":\"Discount\",\"payment.price\":\"Total price\",\"payment.subscribe\":\"Subscribe\",\"payment.pay\":\"Pay\",\"payment.upgrade\":\"Upgrade\",\"payment.downgrade\":\"Downgrade\",\"payment.terms_1\":\"By confirming the purchase, you accept the offer and authorize SYNTX INTELLIGENCE – FZCO company to charge\",\"payment.terms_2\":\" for the subscription. You can cancel your subscription at any time.\",\"payment.terms_1_month\":\"per month\",\"payment.terms_3_month\":\"per 3 months\",\"payment.terms_6_month\":\"per 6 months\",\"payment.terms_12_month\":\"per year\",\"payment.tgInvoice\":\"Invoice has been sent to your Telegram\",\"payment.sameTariff\":\"You are already on this tariff\",\"payment.tariffUpdated\":\"Tariff updated\",\"payment.cancelSubscription\":\"Cancel subscription\",\"payment.canceled\":\"Subscription canceled\",\"payment.nextCharge\":\"Next charge\",\"payment.prePurchaseConfirmationTitle\":\"Payment Information\",\"payment.prePurchaseConfirmationMessage\":\"After payment, the subscription will be activated within 20-30 minutes. Payment systems sometimes do not process transactions immediately.\",\"payment.prePurchaseTokenConfirmationMessage\":\"After payment, the tokens will be credited within 20-30 minutes. Payment systems sometimes do not process transactions immediately.\",\"payment.cancelConfirmationTitle\":\"So sad to see you go, but…\",\"payment.cancelConfirmation\":\"Your new subscription will start after your current one ends – {date}.<br/>Until then, you can keep using your current plan without any limits.\",\"payment.keepSubscription\":\"Keep subscription\",\"payment.paymentMethods.stripe\":\"Europe, Asia, USA\",\"payment.paymentMethods.overpay\":\"Russia cards\",\"payment.paymentMethods.freekassaSBP\":\"Russia SBP\",\"payment.paymentMethods.overpayERIP\":\"Belarus ERI\",\"payment.paymentMethods.overpaySBP\":\"Russia SBP\",\"payment.paymentMethods.paykilla\":\"Cryptocurrencies\",\"payment.paymentMethods.overpayEUR\":\"Uzbekistan\",\"payment.tokenPayments.title\":\"Purchase tokens\",\"payment.tokenPayments.price\":\"For 1 token\",\"payment.tokenPayments.description\":\"Select amount of tokens\",\"payment.tokenPayments.sum\":\"Amount\",\"payment.tokenPayments.tokenPromo\":\"With a promo code you get\",\"payment.success.title\":\"Payment Successful\",\"payment.success.message\":\"Your payment has been processed successfully. You can now enjoy your subscription.\",\"payment.success.disclaimer\":\"If you are not subscribed yet, please wait 20-30 minutes. Your payment is being processed.\",\"payment.failure.title\":\"Payment Failed\",\"payment.failure.message\":\"We were unable to process your payment. Please try again or contact support if the problem persists.\",\"payment.upgradeSuccess.title\":\"Upgrade successful\",\"payment.upgradeSuccess.message\":\"You have successfully upgraded your subscription. You can now enjoy your new plan.\",\"payment.upgradeSuccess.disclaimer\":\"If there is no subscription, wait 20-30 minutes, the payment is being processed\",\"payment.tryAgain\":\"Try again\",\"payment.downgradeDialog.title\":\"All set to switch to your new plan\",\"payment.downgradeDialog.message\":\"Your new subscription will start after your current one ends – {endDate}.<br>Until then, you can keep using your current plan without any limits.\",\"payment.downgradeDialog.keepSubscription\":\"Keep  current plan\",\"payment.tokenAccessDenied.title\":\"Buying tokens is not available\",\"payment.tokenAccessDenied.subtitle\":\"You cannot buy tokens without active subscription. \\nPlease issue one of the proposed subscriptions to buy additional tokens.\",\"payment.unpaid.title\":\"Unpaid subscription\",\"payment.unpaid.subtitle\":\"You have an unpaid subscription. Please pay to continue using the platform.\",\"payment.title\":\"Buying subscription\",\"payment.googleAlert.title\":\"Subscription in Telegram is unavailable\",\"payment.googleAlert.description\":\"The subscription is available only on the SYNTX.AI website and doesn’t work in the Telegram bot because you signed in with email.\",\"payment.googleAlert.confirmCheckbox\":\"I agree\",\"payment.promocodeWrongMinSubscription\":\"Promocode is valid only for subscription purchase starting from\",\"payment.promocodeForSubscription\":\"Promocode is valid only for subscription\",\"payment.promocodeNotValidForYourSubscription\":\"Promocode is not valid with your current tariff\",\"payment.promocodeAlreadyUsed\":\"Promocode already used\",\"priceList.priceWithTokens\":\"Cost with tokens (1 month)\",\"priceList.priceWithoutTokens\":\"Cost without tokens (1 month)\",\"priceList.tokensCount\":\"The number of tokens\",\"payment.promocodeMinTokens\":\"Promocode works only for purchases of {min_tokens} tokens or more\",\"payment.freePromo.plans.free.description\":\"Trial access to tools:<br>Basic access to selected platform features to get started with SYNTX.AI.<br><br>Ideal for getting to know the platform and exploring its core AI capabilities for the first time. It lets you try key use cases at no cost and see which tools fit your needs best.<br><br> A convenient starting point before moving to a paid plan.\",\"payment.freePromo.plans.vip.description\":\"Full AI model package with unlimited access to language models:<br>Seedance New, Kling, Nano Banana, Veo 3.1, GPT-5, Claude Opus 4.1, Grok 4, Gemini 2.5 Pro, and more.<br><br>Designed for ongoing work with text and AI-powered tasks. It includes unlimited access to 30 language models, including GPT-5, Claude Opus 4.1, Grok 4, and Gemini 2.5 Pro, all within a single plan.<br><br> A strong choice for users who need broad, unrestricted access to top language models.\",\"payment.freePromo.plans.pro.description\":\"Full AI model package:<br>Seedance New, Kling, Nano Banana, Veo 3.1, and more.<br><br>Designed for active, ongoing work with AI in a single plan. It gives users access to the platform's full set of core models, GPT agents, and tools for enhancing videos and images.<br><br> An ideal choice for creators, professionals, and teams who need a more powerful plan for everyday work.\",\"payment.freePromo.plans.ultraelite.description\":\"Maximum platform privileges:<br>Additional unlimited options, special terms on top-tier tools, and access to SYNTX.AI's flagship models.<br><br>A flagship plan for the most demanding users and large-scale workloads. It unlocks expanded unlimited capabilities, gives access to special terms on the platform's top tools, and offers maximum freedom for professional content creation. <br><br>The right choice for those who want the very best of SYNTX.AI without compromise.\",\"payment.freePromo.plans.elite.description\":\"Multiple unlimited features in one plan:<br>Unlimited video and image generation in selected models, unlimited access to 30 language models, plus access to Veo 3.1 Lite, Sora, Runway, Topaz, Sora Image, and more.<br><br>Designed for professional content creation and intensive AI workflows. It offers greater flexibility through multiple unlimited features, along with access to the platform's advanced models.<br><br> An ideal choice for professionals and teams who need high capacity with fewer limits.\",\"payment.freePromo.plans.basic.description\":\"Access to core AI models:<br>Kling, Nano Banana, and more.<br><br>Designed for regular use across everyday AI tasks. It gives users access to the platform's core tools for creating images, videos, music, and text in one plan.<br><br> A solid choice for those who want a practical and straightforward plan without extra features they may not need.\",\"payment.freePromo.title\":\"You have successfully received a plan with a <span class=\\\"accent\\\">100% discount</span>:\",\"payment.freePromo.until\":\"until\",\"payment.freePromo.noAutoRenewal\":\"tariff without auto renewal\",\"payment.freePromo.activate\":\"Start creating!\",\"payment.freePromo.tokensDescription\":\"the internal currency of the service\",\"payment.promocodeFreeApplied\":\"Promocode successfully applied\",\"payment.paymentCountry\":\"We identified your country as {country}, so we're showing the payment methods available for your region.\",\"payment.promoDowngradeNotAllowed\":\"This promo code cannot be applied because your current plan is equal to or higher than the offered one\",\"payment.promoDowngradeNotAllowedWithTokens\":\"This promo code cannot be applied because your current plan is equal to or higher than the offered one. You have been credited {tokens} tokens\",\"payment.freePromo.titleGift\":\"You have successfully gifted a plan with a <span class=\\\"accent\\\">100% discount</span>:\",\"payment.freePromo.giftRecipient\":\"Recipient\",\"payment.yourCountry\":\"Your country\",\"payment.paymentMethods.overpayBrazil\":\"Brazil\",\"payment.paymentMethods.overpayIndia\":\"India\",\"payment.changePlan\":\"Change plan\",\"payment.tokenPayments.insufficientTitle\":\"Not enough tokens to generate\",\"payment.giftToInvalid\":\"Enter a valid username.\",\"tariffs.b2b.countryMaxLengthError\":\"Maximum 50 characters\",\"payment.terms_1_offer\":\"By confirming the purchase, you accept the {offer} and authorize SYNTX INTELLIGENCE – FZCO company to charge\",\"payment.terms_offer\":\"offer\",\"err_use_another_period\":\"Please use another period of subscription: {periods}\"}"
