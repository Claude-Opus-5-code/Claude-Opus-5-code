            "size": 5487,
            "mimeType": "application/json",
            "text": "{\"payment.freeTariffDescription\":\"Test requests in almost all tools <br/> 5 demos in the language models <br/> 3 requests/day on Stable Diffusion <br/> 5 requests/day in flux.1\",\"tariffs.title\":\"Pricing\",\"tariffs.allTariffsLink\":\"Compare plans\",\"tariffs.tokenDescription\":\"Tokens are needed to create videos, images and audio. <br>In SYNTX.AI tokens never expire.\",\"tariffs.bigPriceDescription\":\"If you buy all the neural networks separately\",\"tariffs.buy\":\"Pick your plan\",\"tariffs.planComparison\":\"Plan comparison\",\"tariffs.plan\":\"Plan\",\"tariffs.separate\":\"separate\",\"tariffs.noQueue\":\"no queue\",\"tariffs.top\":\"TOP CHOICE\",\"tariffs.mostValuable\":\"BEST VALUE\",\"tariffs.more\":\"more\",\"tariffs.enterpriseButton\":\"Submit form\",\"tariffs.comparisonNote1\":\"- Video generation calculation in the table is done using the Seedance model\",\"tariffs.comparisonNote2\":\"- Audio generation calculation in the table is done using the Suno model\",\"tariffs.comparisonNote3\":\"- Image generation calculation in the table is done using the Flux model\",\"tariffs.b2b.cardDescription\":\"<strong>Do you need 15 or more subscriptions?</strong><br><br>In the corporate tariff, special conditions are applied for business customers and online schools, and you will have your own personal manager in SYNTX.AI<br><br><strong>What do we offer?</strong><ul><li>Individual tariffs</li><li>Discounts on subscriptions for 15 or more people</li><li>Loyal and flexible cooperation terms</li></ul>\",\"tariffs.b2b.description\":\"Fill out the form below to get unique partnership conditions\",\"tariffs.b2b.enterpriseButton\":\"Submit form\",\"tariffs.b2b.name\":\"Name surname\",\"tariffs.b2b.namePlaceholder\":\"Enter your name and surname\",\"tariffs.b2b.username\":\"Telegram username\",\"tariffs.b2b.usernamePlaceholder\":\"Enter your Telegram username\",\"tariffs.b2b.countPlaceholder\":\"Select the required quantity\",\"tariffs.b2b.companyCount\":\"How many subscriptions do you need?\",\"tariffs.b2b.companyCountPlaceholder\":\"Select the number of employees\",\"tariffs.b2b.bloggerCount\":\"How many subscribers do you have?\",\"tariffs.b2b.bloggerCountPlaceholder\":\"Select the number of subscribers\",\"tariffs.b2b.companyType\":\"Who are you?\",\"tariffs.b2b.companyTypePlaceholder\":\"Select who you are\",\"tariffs.b2b.company\":\"Company\",\"tariffs.b2b.blogger\":\"Blogger\",\"tariffs.b2b.school\":\"Online school\",\"tariffs.b2b.employees\":\"Employees\",\"tariffs.b2b.subscribers\":\"Subscribers\",\"tariffs.b2b.email\":\"E-mail\",\"tariffs.b2b.emailPlaceholder\":\"Enter your e-mail\",\"tariffs.b2b.emailError\":\"Please enter a valid e-mail\",\"tariffs.b2b.phone\":\"Phone number/WhatsApp\",\"tariffs.b2b.phonePlaceholder\":\"Enter your phone number/WhatsApp\",\"tariffs.b2b.message\":\"Message\",\"tariffs.b2b.messagePlaceholder\":\"What do you expect from the collaboration\",\"tariffs.b2b.successMessage\":\"Form submitted successfully! Our manager will contact you.\",\"tariffs.b2b.errorMessage\":\"An error occurred while submitting the form\",\"tariffs.b2b.nameMaxLengthError\":\"Name must not exceed 200 characters\",\"tariffs.b2b.lastNameMaxLengthError\":\"Last name must not exceed 200 characters\",\"tariffs.b2b.emailMaxLengthError\":\"E-mail must not exceed 200 characters\",\"tariffs.b2b.phoneDigitError\":\"Phone number must contain digits only\",\"tariffs.b2b.phoneMinLengthError\":\"Phone number must be at least 5 characters\",\"tariffs.b2b.phoneMaxLengthError\":\"Phone number must not exceed 25 characters\",\"tariffs.b2b.messageMaxLengthError\":\"Message must not exceed 1000 characters\",\"tariffs.group.video\":\"Video\",\"tariffs.group.audio\":\"Audio\",\"tariffs.group.text\":\"Text\",\"tariffs.group.images\":\"Images\",\"tariffs.group.design\":\"Image\",\"tariffs.annual\":\"Annual\",\"tariffs.monthly\":\"Monthly\",\"tariffs.b2b.question\":\"Do you need 15 or more subscriptions?\",\"tariffs.b2b.bannerDescription\":\"In the corporate tariff, special conditions are applied for business customers and online schools, and you will have your own personal manager in SYNTX.AI.\",\"tariffs.b2b.offerTitle\":\"What do we offer?\",\"tariffs.b2b.feature1\":\"Individual tariffs\",\"tariffs.b2b.feature2\":\"Discounts on subscriptions for 15 or more people\",\"tariffs.b2b.feature3\":\"Loyal and flexible cooperation terms\",\"tariffs.b2b.emailCooldownError\":\"You have already submitted a request using this e-mail. You can submit a new request in 48 hours.\",\"tariffs.b2b.country\":\"Country of operation\",\"tariffs.b2b.countryPlaceholder\":\"Country\",\"tariffs.b2b.countryError\":\"Please select a country\",\"tariffs.b2b.companyName\":\"Company name\",\"tariffs.b2b.companyNamePlaceholder\":\"Enter your company name\",\"tariffs.b2b.schoolName\":\"School name\",\"tariffs.b2b.schoolNamePlaceholder\":\"Enter your school name\",\"tariffs.b2b.students\":\"students\",\"tariffs.b2b.schoolCount\":\"Select number of students\",\"tariffs.b2b.schoolCountPlaceholder\":\"Select number of students\",\"tariffs.atMonth\":\"per month\",\"tariffs.b2b.title\":\"Enterprise\",\"tariffs.noLimit\":\"No limit\",\"tariffs.discount\":\"off\",\"tariffs.modelName\":\"Model\",\"tariffs.cost\":\"Cost\",\"tariffs.limits\":\"Limits\",\"tariffs.requestsNote1\":\"- The number of available requests depends on the size of your request, the generated response, and the conversation context.\",\"tariffs.requestsNote2\":\"- Once you reach the limit, you can continue using models with no request limits.\",\"tariffs.upgradeDailyLimitNotice\":\"Upgrade to {plan} to get more requests every day.\",\"tariffs.upgradeDailyLimitTitle\":\"Get {n}x the daily limit\",\"tariffs.choosePlanNamed\":\"Choose the {plan} plan\",\"tariffs.increaseRequestLimit\":\"Get {count}x the base request limit\"}"
